# Ignore node modules
node_modules/

# Ignore Expo-generated files
.expo/
.expo-shared/

# Ignore environment variables
.env
.env.local
.env.development
.env.production

# Ignore lock files (choose npm or yarn, not both)
package-lock.json
yarn.lock

# Ignore TypeScript build output
dist/
build/

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore editor-specific files
.vscode/
.idea/
.DS_Store
Thumbs.db
